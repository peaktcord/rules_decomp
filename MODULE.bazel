module(
    name = "rules_decomp",
    version = "0.1.0",
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_foreign_cc", version = "0.15.1")

decomp = use_extension("//:extensions.bzl", "decomp")
decomp.pypy(version = "7.3.23")
decomp.sdl3(version = "3.4.14")
decomp.vice(version = "3.10")
use_repo(decomp, "decomp_pypy", "decomp_sdl3", "decomp_vice")

register_toolchains(
    "@decomp_pypy//:toolchain",
    "@decomp_vice//:toolchain",
)

# Analysis-only fixture for this module's Ghidra rule tests. Dependency users do
# not inherit registrations marked dev_dependency.
register_toolchains("//tests:ghidra_toolchain", dev_dependency = True)

# Package-loading fixture for the Linux foreign-CMake overlay. It is fetched
# only by an explicit development query and is not visible to module consumers.
sdl3_test_repository = use_repo_rule(
    "//repositories:sdl3.bzl",
    "sdl3_repository",
)
sdl3_test_repository(
    name = "decomp_sdl3_linux_analysis",
    platform = "linux",
    version = "3.4.14",
)

# Fixture for the local tool repository rule; consumers never reference it.
local_tool_repository = use_repo_rule("//repositories:local_tool.bzl", "local_tool_repository")
local_tool_repository(
    name = "decomp_local_tool_fixture",
    aliases = {"tool": "bin/tool.txt"},
    default_path = "tests/fixture_tool",
    env_var = "DECOMP_LOCAL_TOOL_FIXTURE",
    links = {"bin": "bin"},
    required = ["bin/tool.txt"],
)
