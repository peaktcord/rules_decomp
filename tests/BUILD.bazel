load("//decomp:defs.bzl", "ghidra_oracle", "ghidra_pipeline", "ghidra_session", "sentinel_test", "verified_files")
load("//toolchains/ghidra:toolchain.bzl", "ghidra_runtime")

package(default_visibility = ["//visibility:private"])

verified_files(
    name = "verified_input",
    srcs = ["input.txt"],
    manifest = "input.sha256",
)

sentinel_test(
    name = "sentinel_test",
    actual = "input.txt",
    expected = "expected.txt",
)

ghidra_runtime(
    name = "fake_ghidra_runtime",
    analyzer = "fake_analyzeHeadless.bat",
    files = ":fake_ghidra_files",
    gui = "fake_ghidraRun.bat",
    java = "input.txt",
    windows = True,
)

filegroup(
    name = "fake_ghidra_files",
    srcs = [
        "fake_analyzeHeadless.bat",
        "fake_ghidraRun.bat",
        "input.txt",
    ],
)

toolchain(
    name = "ghidra_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    toolchain = ":fake_ghidra_runtime",
    toolchain_type = "//toolchains/ghidra:toolchain_type",
)

ghidra_pipeline(
    name = "ghidra_pipeline_analysis",
    srcs = ["input.txt"],
    steps = [{
        "action": "import",
        "input": "$(location input.txt)",
        "noanalysis": True,
        "extra_args": ["--emit", "$OUTPUT_DIR/report.txt"],
    }],
    tags = ["manual"],
)

ghidra_oracle(
    name = "ghidra_oracle_analysis",
    completion_markers = [{
        "path": "oracle.txt",
        "contains": "complete=true",
    }],
    srcs = ["input.txt"],
    steps = [{
        "action": "import",
        "input": "$(location input.txt)",
        "noanalysis": True,
        "extra_args": ["--emit", "$OUTPUT_DIR/oracle.txt"],
    }],
    tags = ["manual"],
)

ghidra_session(
    name = "ghidra_session_analysis",
    tags = ["manual"],
)
