load("//decomp:defs.bzl", "check_test", "ghidra_oracle", "ghidra_pipeline", "ghidra_session", "image_splice", "script_check", "sentinel_test", "staged_file", "verified_files")
load("//toolchains/ghidra:toolchain.bzl", "ghidra_runtime")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

verified_files(
    name = "verified_input",
    srcs = ["input.txt"],
    manifest = "input.sha256",
)

sentinel_test(
    name = "sentinel_test",
    actual = "input.txt",
    expected = "expected.txt",
)

cc_test(
    name = "sdl3_smoke",
    srcs = ["sdl3_smoke.cpp"],
    defines = select({
        "@platforms//cpu:x86_32": ["DECOMP_EXPECTED_POINTER_BYTES=4"],
        "@platforms//cpu:x86_64": ["DECOMP_EXPECTED_POINTER_BYTES=8"],
    }),
    deps = ["@decomp_sdl3//:sdl3"],
)

ghidra_runtime(
    name = "fake_ghidra_runtime",
    analyzer = "fake_analyzeHeadless.bat",
    files = ":fake_ghidra_files",
    gui = "fake_ghidraRun.bat",
    java = "input.txt",
    windows = True,
)

filegroup(
    name = "fake_ghidra_files",
    srcs = [
        "fake_analyzeHeadless.bat",
        "fake_ghidraRun.bat",
        "input.txt",
    ],
)

toolchain(
    name = "ghidra_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:windows",
    ],
    toolchain = ":fake_ghidra_runtime",
    toolchain_type = "//toolchains/ghidra:toolchain_type",
)

ghidra_pipeline(
    name = "ghidra_pipeline_analysis",
    srcs = ["input.txt"],
    steps = [{
        "action": "import",
        "input": "$(location input.txt)",
        "noanalysis": True,
        "extra_args": ["--emit", "$OUTPUT_DIR/report.txt"],
    }],
    tags = ["manual"],
)

ghidra_oracle(
    name = "ghidra_oracle_analysis",
    completion_markers = [{
        "path": "oracle.txt",
        "contains": "complete=true",
    }],
    srcs = ["input.txt"],
    steps = [{
        "action": "import",
        "input": "$(location input.txt)",
        "noanalysis": True,
        "extra_args": ["--emit", "$OUTPUT_DIR/oracle.txt"],
    }],
    tags = ["manual"],
)

ghidra_session(
    name = "ghidra_session_analysis",
    tags = ["manual"],
)

script_check(
    name = "check_ok",
    args = ["--expect", "fixture"],
    env = {"CHECK_FIXTURE": "set"},
    private = False,
    script = "check_script.py",
)

check_test(
    name = "check_test",
    check = ":check_ok",
)

staged_file(
    name = "staged_fixture_tool",
    out = "staged_tool.txt",
    src = "@decomp_local_tool_fixture//:tool",
)

sentinel_test(
    name = "local_tool_staged_test",
    actual = ":staged_fixture_tool",
    expected = "fixture_tool/bin/tool.txt",
)

image_splice(
    name = "spliced_input",
    original = ":verified_input",
    pieces = ["piece.txt"],
    placements = "placements.tsv",
)

sentinel_test(
    name = "image_splice_test",
    actual = ":spliced_input",
    expected = "expected.txt",
)
